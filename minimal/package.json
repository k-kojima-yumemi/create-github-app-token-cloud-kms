{
  "name": "create-github-app-token-cloud-kms-minimal",
  "private": true,
  "type": "module",
  "version": "1.1.0",
  "author": "k-kojima-yumemi",
  "dependencies": {
    "@actions/core": "^3.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.14",
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "volta": {
    "node": "24.15.0"
  },
  "scripts": {
    "bundle": "npm run package",
    "check": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "package": "esbuild src/index.ts src/post.ts --bundle --platform=node --target=node24 --format=cjs --out-extension:.js=.cjs --outdir=dist",
    "all": "npm run check && npm run typecheck && npm run test && npm run package"
  }
}
