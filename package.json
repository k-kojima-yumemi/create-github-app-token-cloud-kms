{
  "name": "create-github-app-token-cloud-kms",
  "description": "Creates a GitHub App token using Cloud KMS for signing",
  "version": "0.0.0",
  "author": "",
  "type": "module",
  "private": true,
  "keywords": [
    "actions"
  ],
  "exports": {
    ".": "./dist/index.js"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "bundle": "npm run package",
    "ci-test": "vitest run --coverage",
    "format": "biome check --write --unsafe",
    "lint": "biome lint .",
    "check": "biome check .",
    "package": "esbuild src/index.ts src/post.ts --bundle --platform=node --target=node24 --format=esm --outdir=dist",
    "test": "vitest run",
    "typecheck": "tsc --noemit",
    "all": "npm run check && npm run typecheck && npm run test && npm run package"
  },
  "volta": {
    "node": "24.15.0"
  },
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^3.0.0",
    "@google-cloud/kms": "^5.5.0",
    "google-auth-library": "^10.6.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.14",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^3.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^6.0.3",
    "vitest": "^3.0.0"
  }
}
