{
  "name": "create-github-app-token-cloud-kms",
  "description": "Creates a GitHub App token using Cloud KMS for signing",
  "version": "1.3.0",
  "author": "k-kojima-yumemi",
  "type": "module",
  "private": true,
  "keywords": [
    "actions"
  ],
  "exports": {
    ".": "./dist/index.js"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "bundle": "npm run package",
    "ci-test": "vitest run --coverage",
    "format": "biome check --write --unsafe",
    "lint": "biome lint .",
    "check": "biome check .",
    "package": "esbuild src/entrypoint/index.ts src/entrypoint/post.ts src/entrypoint/minimal.index.ts src/entrypoint/minimal.post.ts --bundle --platform=node --target=node24 --format=cjs --out-extension:.js=.cjs --outdir=dist",
    "test": "vitest run",
    "typecheck": "tsc --noemit",
    "all": "npm run check && npm run typecheck && npm run test && npm run package"
  },
  "volta": {
    "node": "24.16.0"
  },
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@google-cloud/kms": "^5.5.1",
    "google-auth-library": "^10.9.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.2",
    "@types/node": "^24.13.2",
    "@vitest/coverage-v8": "^4.1.9",
    "esbuild": "^0.28.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
